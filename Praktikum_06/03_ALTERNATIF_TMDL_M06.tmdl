createOrReplace

    ref table _Measures

        /// Praktikum 06 menggunakan kolom Profit: berbeda dari Gross Profit Praktikum 05.
        measure 'Gross Profit' = SUM('Fact_Sales'[Profit])
            formatString: #,##0.00
            displayFolder: 01_Financial

        /// Gross Profit (berbasis Profit) dibagi Total Sales; definisi Praktikum 06.
        measure 'Profit Margin' = DIVIDE([Gross Profit], [Total Sales], 0)
            formatString: 0.0%
            displayFolder: 01_Financial

        /// Jumlah target penjualan per bulan dan cabang, dipengaruhi relasi Dim_Date serta Dim_Branch.
        measure 'Sales Target' = SUM('Fact_Target'[Sales_Target])
            formatString: #,##0.00
            displayFolder: 01_Financial

        /// Rasio aktual Total Sales terhadap Sales Target.
        measure 'Target Achievement %' = DIVIDE([Total Sales], [Sales Target], 0)
            formatString: 0.0%
            displayFolder: 01_Financial

        /// Alias berbahasa Indonesia untuk dashboard Praktikum 07.
        measure 'Total Penjualan' = [Total Sales]
            formatString: #,##0.00
            displayFolder: 04_Dashboard

        /// Alias untuk laba Praktikum 06–07 menggunakan kolom Profit.
        measure 'Total Laba' = [Gross Profit]
            formatString: #,##0.00
            displayFolder: 04_Dashboard

        /// Alias margin berbasis Profit Praktikum 06–07.
        measure 'Margin Laba' = [Profit Margin]
            formatString: 0.0%
            displayFolder: 04_Dashboard

        /// Alias jumlah Transaction_ID unik.
        measure 'Jumlah Transaksi' = [Orders]
            formatString: #,##0
            displayFolder: 04_Dashboard

        /// Judul dinamis untuk halaman Branch Detail.
        measure 'Judul Cabang' = SELECTEDVALUE('Dim_Branch'[Branch_Name], "Seluruh Cabang")
            displayFolder: 04_Dashboard

